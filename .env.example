# ── Which backend holds the posts ────────────────────────────────────────────
# neon      Neon Postgres plus Vercel Blob   (default)
# supabase  Supabase Postgres plus Storage   (switch to this when your account frees up)
BLOG_STORE=neon

# ── Sign in. One password, no user system. ───────────────────────────────────
# Make both with:  openssl rand -base64 24
# Changing SESSION_SECRET signs you out everywhere, which is the emergency stop.
ADMIN_PASSWORD=
SESSION_SECRET=

# ── Neon ─────────────────────────────────────────────────────────────────────
# neon.com, new project, copy the pooled connection string. No card needed.
DATABASE_URL=

# ── Images ───────────────────────────────────────────────────────────────────
# Vercel dashboard, Storage tab, create a Blob store. Vercel sets this for you on deploy.
BLOB_READ_WRITE_TOKEN=

# ── Only needed if BLOG_STORE=supabase ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Used for the sitemap and link previews ───────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://itssaharsh.vercel.app
